      objectReference: {fileID: 0}
    - target: {fileID: 8342701953548561964, guid: e7845076b07350f4a874cfee3336f381, type: 3}
      propertyPath: m_text
      value: "<i> This exhibition is still in progress</i>\n<size=0.6em> \nUnfortunately,
        a body was found in a lake close by the cottage of this Nameless Painter.
        He often painted this lake, but instead of the lush and serene depictions,
        they became more bleak and hopeless.  Perhaps he found comfort in the darkness?"
      objectReference: {fileID: 0}
